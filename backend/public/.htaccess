RewriteEngine On

# ApacheがAuthorizationヘッダーをデフォルトではPHPの$_SERVERに渡さない問題への対処。
# mod_phpではセキュリティ上の理由でAuthorizationヘッダーが$_SERVER['HTTP_AUTHORIZATION']に
# 渡らないことがあり、これがFirebaseAuthenticatorが常にguestフォールバックしていた根本原因だった。
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
